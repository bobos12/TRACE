# The canonical origin is fixed in src/lib/site.ts (https://trace-studio.tech).
# NEXT_PUBLIC_SITE_URL is only read by scripts/make-og.mjs and make-social.mjs
# to print the domain on share images; leave it unset to use trace-studio.tech.

# ─── Contact form backends (both optional) ─────────────────────────────────
# With neither set, the form falls back to opening an email with the message
# prefilled. It never silently fails.

# Supabase — inserts each lead into a `leads` table.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend — emails each lead to LEADS_TO_EMAIL.
RESEND_API_KEY=
LEADS_TO_EMAIL=info@trace-studio.tech
# Must be a verified sender on your Resend domain.
LEADS_FROM_EMAIL=TRACE website <website@trace-studio.tech>

# ─── Website assistant (the chat in the corner) ────────────────────────────
# Google Gemini API key from https://aistudio.google.com/apikey. Server-only —
# never prefix it with NEXT_PUBLIC_. Without it the chat still opens and
# offers the booking link and email instead of answering.
GEMINI_API_KEY=
# Optional. Any Gemini model id; defaults to gemini-3.8-flash.
GEMINI_MODEL=
