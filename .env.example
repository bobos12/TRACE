# ─── Required for correct canonical URLs, hreflang, sitemap and OG images ───
# No trailing slash. Set this in Vercel for production and preview.
NEXT_PUBLIC_SITE_URL=https://athr.studio

# ─── Contact form backends (both optional) ─────────────────────────────────
# With neither set, the form falls back to opening WhatsApp with the message
# prefilled. It never silently fails.

# Supabase — inserts each lead into a `leads` table.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend — emails each lead to LEADS_TO_EMAIL.
RESEND_API_KEY=
LEADS_TO_EMAIL=
# Must be a verified sender on your Resend domain.
LEADS_FROM_EMAIL=ATHR website <website@athr.studio>
